#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "NAMA_WIFI_KAMU";
const char* password = "PASSWORD_WIFI_KAMU";

WebServer server(80);
const int ledPin = 25;

void setup() {
  Serial.begin(115200);
  pinMode(ledPin, OUTPUT);
  digitalWrite(ledPin, LOW);

  WiFi.begin(ssid, password);
  Serial.print("Menghubungkan ke WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nTerhubung!");
  Serial.println(WiFi.localIP());

  // Halaman utama
  server.on("/", HTTP_GET, []() {
    String html = R"rawliteral(
      <!DOCTYPE html>
      <html>
      <head>
        <title>Kontrol LED</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
      </head>
      <body style='text-align:center; font-family:sans-serif; padding-top:50px;'>
        <h1>Kontrol LED dengan Tombol & Suara</h1>
        <button onclick="nyalakanLED()" style="font-size:24px; padding:15px; margin:10px;">Nyalakan LED</button>
        <button onclick="matikanLED()" style="font-size:24px; padding:15px; margin:10px;">Matikan LED</button>
        <br><br>
        <button onclick="mulaiVoice()" style="font-size:24px; padding:15px;">Perintah Suara</button>
        <p id="status"></p>

        <script>
          function nyalakanLED() {
            fetch("/nyala");
          }

          function matikanLED() {
            fetch("/mati");
          }

          function mulaiVoice() {
            const status = document.getElementById("status");
            if (!('webkitSpeechRecognition' in window)) {
              status.innerText = "Browser tidak mendukung voice recognition";
              return;
            }

            let recognition = new webkitSpeechRecognition();
            recognition.lang = "id-ID";
            recognition.start();
            status.innerText = "Mendengarkan...";

            recognition.onresult = function(event) {
              let hasil = event.results[0][0].transcript.toLowerCase();
              status.innerText = "Perintah: " + hasil;
              if (hasil.includes("nyalakan") || hasil.includes("hidupkan")) {
                nyalakanLED();
              } else if (hasil.includes("matikan") || hasil.includes("padamkan")) {
                matikanLED();
              }
            }

            recognition.onerror = function(event) {
              status.innerText = "Error: " + event.error;
            }
          }
        </script>
      </body>
      </html>
    )rawliteral";
    server.send(200, "text/html", html);
  });

  server.on("/nyala", HTTP_GET, []() {
    digitalWrite(ledPin, HIGH);
    server.send(200, "text/plain", "LED dinyalakan");
  });

  server.on("/mati", HTTP_GET, []() {
    digitalWrite(ledPin, LOW);
    server.send(200, "text/plain", "LED dimatikan");
  });

  server.begin();
  Serial.println("Web server aktif!");
}

void loop() {
  server.handleClient();
}
